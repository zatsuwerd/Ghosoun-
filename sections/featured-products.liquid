{%- style -%}
  #shopify-section-{{ section.id }} .featured-products-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{%- assign target_collection = collections[section.settings.collection] -%}

<section class="featured-products-section" aria-labelledby="FeaturedProductsHeading-{{ section.id }}">
  <div class="page-width">
    <div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1.6rem; margin-bottom: 3.6rem;">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="botanical-page-eyebrow" style="margin-bottom: 0.6rem;">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 id="FeaturedProductsHeading-{{ section.id }}" style="margin-bottom: 0;">
          {{ section.settings.heading | default: target_collection.title | escape }}
        </h2>
      </div>

      {%- if target_collection != blank -%}
        <a href="{{ target_collection.url }}" class="btn btn-secondary btn-sm">
          {{ 'sections.collection_tabs.view_all' | t: title: target_collection.title }}
        </a>
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}" class="btn btn-secondary btn-sm">
          {{ 'sections.header.shop_all' | t }}
        </a>
      {%- endif -%}
    </div>

    {%- if target_collection != blank and target_collection.products_count > 0 -%}
      <div class="botanical-grid-4">
        {%- for product in target_collection.products limit: section.settings.products_to_show -%}
          {%- render 'product-card',
            product: product,
            card_ratio: section.settings.image_ratio
          -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="botanical-grid-4">
        {%- render 'demo-product-card',
          title: 'Tunisian Rosemary Essential Oil',
          botanical: 'Rosmarinus officinalis',
          origin: 'Tunisia',
          price: '69 AED',
          compare_price: '85 AED',
          badge: 'Single-Origin',
          category: 'essential'
        -%}
        {%- render 'demo-product-card',
          title: 'High-Altitude French Lavender',
          botanical: 'Lavandula angustifolia',
          origin: 'Provence',
          price: '79 AED',
          badge: '100% Pure',
          category: 'essential'
        -%}
        {%- render 'demo-product-card',
          title: 'Virgin Moroccan Argan Oil',
          botanical: 'Argania spinosa',
          origin: 'Morocco',
          price: '95 AED',
          compare_price: '115 AED',
          badge: 'Cold-Pressed',
          category: 'carrier'
        -%}
        {%- render 'demo-product-card',
          title: 'Alabaster Ceramic Diffuser',
          botanical: 'Ultrasonic Cold Mist',
          origin: 'Artisan Studio',
          price: '295 AED',
          badge: 'Home Ritual',
          category: 'diffuser'
        -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Curated Selection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Daily Botanical Staples"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 2,
      "label": "Products to Show",
      "default": 4
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Card Image Ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/5", "label": "Botanical Tall (4:5)" }
      ],
      "default": "4/5"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
