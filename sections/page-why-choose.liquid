{%- style -%}
  #shopify-section-{{ section.id }} .why-choose-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="why-choose-section">
  <div class="botanical-page-hero">
    <div class="page-width">
      <p class="botanical-page-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1>{{ section.settings.heading | default: page.title | escape }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="botanical-page-subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="page-width" style="padding-top: 5rem;">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 2.4rem; margin-bottom: 5.5rem;">
      {%- for block in section.blocks -%}
        {%- if block.type == 'advantage' -%}
          <div
            style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--card-radius); padding: 2.8rem;"
            {{ block.shopify_attributes }}
          >
            <p class="botanical-page-eyebrow" style="margin-bottom: 0.6rem;">{{ block.settings.badge_text | escape }}</p>
            <h2 style="font-size: 2rem; margin-bottom: 1rem;">{{ block.settings.title | escape }}</h2>
            <p style="font-size: 1.45rem; color: var(--color-text-muted); margin: 0;">{{ block.settings.description | escape }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_comparison -%}
      <div>
        <div style="text-align: center; margin-bottom: 2.8rem;">
          <p class="botanical-page-eyebrow">{{ section.settings.comparison_eyebrow | escape }}</p>
          <h2>{{ section.settings.comparison_heading | escape }}</h2>
        </div>

        <div class="why-comparison-table-wrap">
          <table class="why-comparison-table">
            <thead>
              <tr>
                <th>{{ section.settings.col_standard | escape }}</th>
                <th>{{ section.settings.col_ghosoun | escape }}</th>
                <th>{{ section.settings.col_conventional | escape }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for block in section.blocks -%}
                {%- if block.type == 'comparison_row' -%}
                  <tr {{ block.shopify_attributes }}>
                    <td style="font-weight: 600; color: var(--color-primary);">{{ block.settings.criterion | escape }}</td>
                    <td style="color: var(--color-accent); font-weight: 600;">{{ block.settings.ghosoun_val | escape }}</td>
                    <td style="color: var(--color-text-muted);">{{ block.settings.commercial_val | escape }}</td>
                  </tr>
                {%- endif -%}
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Why Choose Ghosoun",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Ghosoun Standard"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose Ghosoun Botanicals"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Every harvest is selected from authentic growing regions, cold-pressed or steam-distilled gently, and bottled in UV-protective glass."
    },
    {
      "type": "checkbox",
      "id": "show_comparison",
      "label": "Show Quality Comparison Table",
      "default": true
    },
    {
      "type": "text",
      "id": "comparison_eyebrow",
      "label": "Comparison Eyebrow",
      "default": "Formulation Benchmark"
    },
    {
      "type": "text",
      "id": "comparison_heading",
      "label": "Comparison Heading",
      "default": "How Ghosoun Compares to Conventional Oils"
    },
    {
      "type": "text",
      "id": "col_standard",
      "label": "Standard Column Title",
      "default": "Quality Benchmark"
    },
    {
      "type": "text",
      "id": "col_ghosoun",
      "label": "Brand Column Title",
      "default": "Ghosoun"
    },
    {
      "type": "text",
      "id": "col_conventional",
      "label": "Conventional Column Title",
      "default": "Conventional Commercial Oils"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "advantage",
      "name": "Purity Advantage",
      "settings": [
        {
          "type": "text",
          "id": "badge_text",
          "label": "Kicker",
          "default": "100% Unrefined"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Zero Synthetic Diluents"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Never stretched with cheaper fractions, propylene glycol, or lab-synthesized fragrance oils."
        }
      ]
    },
    {
      "type": "comparison_row",
      "name": "Comparison Row",
      "settings": [
        {
          "type": "text",
          "id": "criterion",
          "label": "Standard",
          "default": "Botanical Origin"
        },
        {
          "type": "text",
          "id": "ghosoun_val",
          "label": "Ghosoun",
          "default": "Single-Origin Farm Traced"
        },
        {
          "type": "text",
          "id": "commercial_val",
          "label": "Commercial Alternative",
          "default": "Anonymous Multi-Region Brokers"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Choose Ghosoun",
      "blocks": [
        {
          "type": "advantage",
          "settings": {
            "badge_text": "01 · Extraction",
            "title": "First-Press Cold Extraction",
            "description": "Carrier oils are never deodorized, bleached, or solvent-extracted so natural phytonutrients remain intact."
          }
        },
        {
          "type": "advantage",
          "settings": {
            "badge_text": "02 · Packaging",
            "title": "UV-Shielded Dark Glass",
            "description": "Thick UV-filtering dark glass safeguards delicate aromatic esters and lipids from light degradation."
          }
        },
        {
          "type": "advantage",
          "settings": {
            "badge_text": "03 · Transparency",
            "title": "Full Botanical Labeling",
            "description": "Every label lists Latin botanical name, plant part distilled, extraction process, and country of origin."
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "criterion": "Ingredient Transparency",
            "ghosoun_val": "Full Latin Name, Country & Plant Part",
            "commercial_val": "Often Vague 'Fragrance' Blends"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "criterion": "Light Protection",
            "ghosoun_val": "UV-Protective Dark Glass",
            "commercial_val": "Clear Glass or Thin Plastic"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "criterion": "Formulation Purity",
            "ghosoun_val": "Unrefined Single-Origin Botanicals",
            "commercial_val": "Cut With Synthetic Diluents"
          }
        }
      ]
    }
  ]
}
{% endschema %}
