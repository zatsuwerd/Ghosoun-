{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="featured-tabs-section" data-section-id="{{ section.id }}">
  <div class="page-width">

    <div class="section-header-center">
      {%- if section.settings.subheading != blank -%}
        <span class="section-eyebrow">{{ section.settings.subheading | escape }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>

    <collection-tabs>
      <div class="tabs-nav" role="tablist" aria-label="{{ section.settings.heading | escape }}">
        {%- for block in section.blocks -%}
          {%- assign collection = collections[block.settings.collection] -%}
          <button
            type="button"
            id="tab-trigger-{{ block.id }}"
            class="tab-trigger {% if forloop.first %}is-active{% endif %}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="tab-panel-{{ block.id }}"
            data-tab-target="#tab-panel-{{ block.id }}"
          >
            {{ block.settings.tab_title | default: collection.title | escape }}
          </button>
        {%- endfor -%}
      </div>

      <div class="tabs-content">
        {%- for block in section.blocks -%}
          {%- assign collection = collections[block.settings.collection] -%}
          <div
            id="tab-panel-{{ block.id }}"
            class="tabs-panel {% if forloop.first %}is-active{% endif %}"
            role="tabpanel"
            aria-labelledby="tab-trigger-{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            {%- if collection != blank and collection.products_count > 0 -%}
              {%- for product in collection.products limit: section.settings.products_to_show -%}
                {% render 'product-card', card_product: product, ratio: section.settings.card_ratio %}
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..section.settings.products_to_show) -%}
                {% render 'demo-product-card', demo_index: i, demo_tab: block.settings.tab_title, ratio: section.settings.card_ratio %}
              {%- endfor -%}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </collection-tabs>

  </div>
</section>

{% schema %}
{
  "name": "Collection Tabs",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Curated Botanicals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ghosoun Signature Selection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Products to display per tab",
      "default": 8
    },
    {
      "type": "select",
      "id": "card_ratio",
      "label": "Card Ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/5", "label": "Tall (4:5)" }
      ],
      "default": "4/5"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Spacing",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Collection Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_title",
          "label": "Tab Label",
          "default": "Bestsellers"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Tabs",
      "blocks": [
        { "type": "tab", "settings": { "tab_title": "Bestsellers" } },
        { "type": "tab", "settings": { "tab_title": "Essential Oils" } },
        { "type": "tab", "settings": { "tab_title": "Carrier Oils" } },
        { "type": "tab", "settings": { "tab_title": "Diffusers" } }
      ]
    }
  ]
}
{% endschema %}
