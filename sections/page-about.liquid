{%- style -%}
  #shopify-section-{{ section.id }} .about-page-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="about-page-section">
  <div class="botanical-page-hero">
    <div class="page-width">
      <p class="botanical-page-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1>{{ section.settings.heading | default: page.title | escape }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="botanical-page-subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="page-width" style="padding-top: 5rem;">
    <div class="contact-grid" style="align-items: center;">
      <div>
        <h2 style="margin-bottom: 1.8rem;">{{ section.settings.story_heading | escape }}</h2>
        <div class="rte" style="color: var(--color-text-muted); font-size: 1.55rem; line-height: 1.8;">
          {{ section.settings.story_body }}
        </div>
        {%- if page.content != blank -%}
          <div class="rte" style="margin-top: 2rem; color: var(--color-text-muted);">
            {{ page.content }}
          </div>
        {%- endif -%}
      </div>

      <div>
        {%- if section.settings.story_image != blank -%}
          {{ section.settings.story_image | image_url: width: 900 | image_tag:
            widths: '450, 700, 900',
            alt: section.settings.story_heading,
            loading: 'lazy',
            style: 'border-radius: var(--image-radius, 6px); border: 1px solid var(--color-border);'
          }}
        {%- else -%}
          <div style="aspect-ratio: 4/3; background: radial-gradient(circle at top right, rgba(197, 155, 67, 0.18), transparent 55%), linear-gradient(145deg, #0D2F32 0%, #217C42 100%); color: #FAF9F5; border: 1px solid var(--color-border); border-radius: var(--card-radius); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 3rem; text-align: center;">
            <span class="botanical-page-eyebrow" style="color: var(--color-accent);">{{ shop.name }}</span>
            <p class="h3" style="color: #FAF9F5; margin-bottom: 0.8rem;">Rooted in Authentic Origin</p>
            <p style="font-size: 1.35rem; opacity: 0.88; margin: 0;">Thoughtfully harvested botanical oils shaped for daily rituals.</p>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 2.4rem; margin-top: 5.5rem;">
        {%- for block in section.blocks -%}
          <div
            style="background: var(--color-card-bg, #FFFFFF); border: 1px solid var(--color-border); border-radius: var(--card-radius); padding: 2.8rem;"
            {{ block.shopify_attributes }}
          >
            <p class="botanical-page-eyebrow" style="margin-bottom: 0.8rem;">{{ block.settings.metric | escape }}</p>
            <h3 style="font-size: 2rem; margin-bottom: 1rem;">{{ block.settings.title | escape }}</h3>
            <p style="font-size: 1.4rem; color: var(--color-text-muted); margin: 0;">{{ block.settings.description | escape }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "About Us Story Page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Story & Craft"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Page Heading",
      "default": "Ghosoun · Inspired by Living Botanicals"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Dedicated to bringing unrefined, single-origin essential oils and cold-pressed botanical care into everyday rituals."
    },
    {
      "type": "text",
      "id": "story_heading",
      "label": "Editorial Story Heading",
      "default": "Why Native Origin Defines Quality"
    },
    {
      "type": "richtext",
      "id": "story_body",
      "label": "Story Content",
      "default": "<p>Soil profile, climate, and careful harvest timing shape the natural character of every botanical extract. Rather than relying on synthetic fragrances or diluted blends, Ghosoun partners with growers committed to clean extraction.</p><p>Each oil is packaged in protective dark glass bottles designed to shield delicate compounds from light.</p>"
    },
    {
      "type": "image_picker",
      "id": "story_image",
      "label": "Boutique / Origin Image"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Brand Pillar",
      "settings": [
        {
          "type": "text",
          "id": "metric",
          "label": "Metric / Kicker",
          "default": "01 · Traceability"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Single-Origin Integrity"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Every bottle states its botanical species, plant part, origin region, and extraction method clearly."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Us Story Page",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "metric": "01 · Traceability",
            "title": "Single-Origin Sourcing",
            "description": "Carefully selected botanical harvests sourced from regions suited to each plant species."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "metric": "02 · Purity",
            "title": "Undiluted Formulations",
            "description": "Free from synthetic fragrances, mineral oils, or artificial colorants."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "metric": "03 · Preservation",
            "title": "Dark Glass Vessels",
            "description": "Light-filtering bottles crafted to preserve natural aroma and cold-pressed nutrients."
          }
        }
      ]
    }
  ]
}
{% endschema %}
