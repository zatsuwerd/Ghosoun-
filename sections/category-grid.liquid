{%- style -%}
  #shopify-section-{{ section.id }} .category-grid-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="category-grid-section" aria-labelledby="CategoryGridHeading-{{ section.id }}">
  <div class="page-width">
    <div style="text-align: center; margin-bottom: 4rem;">
      {%- if section.settings.eyebrow != blank -%}
        <p class="botanical-page-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 id="CategoryGridHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="botanical-page-subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </div>

    <div class="botanical-grid-4">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col_obj = collections[block.settings.collection]
          assign card_title = block.settings.title
          if card_title == blank and col_obj != blank
            assign card_title = col_obj.title
          endif
          assign card_url = block.settings.custom_url
          if card_url == blank and col_obj != blank
            assign card_url = col_obj.url
          elsif card_url == blank
            assign card_url = routes.collections_url
          endif
          assign card_img = block.settings.image
          if card_img == blank and col_obj != blank
            assign card_img = col_obj.featured_image
          endif
        -%}
        <a
          href="{{ card_url }}"
          class="category-card"
          {{ block.shopify_attributes }}
        >
          <div class="category-card-media">
            {%- if card_img != blank -%}
              {{ card_img | image_url: width: 720 | image_tag:
                widths: '360, 540, 720',
                sizes: '(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw',
                alt: card_img.alt | default: card_title,
                loading: 'lazy'
              }}
            {%- else -%}
              <div style="width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.8rem; background: linear-gradient(145deg, var(--color-bg-secondary), var(--color-bg)); color: var(--color-primary); padding: 2rem; text-align: center;">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                <span style="font-family: var(--font-heading-family); font-size: 1.8rem;">{{ card_title | escape }}</span>
              </div>
            {%- endif -%}
          </div>

          <div class="category-card-body">
            {%- if block.settings.kicker != blank -%}
              <span style="font-size: 1.1rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-accent); margin-bottom: 0.4rem;">
                {{ block.settings.kicker | escape }}
              </span>
            {%- endif -%}
            <h3 class="h4" style="margin-bottom: 0.5rem;">{{ card_title | escape }}</h3>
            {%- if col_obj != blank and section.settings.show_product_count -%}
              <p style="font-size: 1.3rem; color: var(--color-text-muted); margin-bottom: 0.8rem;">
                {{ 'collections.general.products_count' | t: count: col_obj.all_products_count }}
              </p>
            {%- elsif block.settings.caption != blank -%}
              <p style="font-size: 1.3rem; color: var(--color-text-muted); margin-bottom: 0.8rem;">
                {{ block.settings.caption | escape }}
              </p>
            {%- endif -%}
            <span style="margin-top: auto; font-size: 1.25rem; font-weight: 600; color: var(--color-secondary);">
              {{ 'collections.general.view_collection' | t }}
            </span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category Grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Curated Botanicals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore by Ritual & Origin"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Navigate pure essential oils, cold-pressed carrier elixirs, ceramic diffusers, and skin remedies."
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show Collection Product Count",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image (overrides collection image)"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "Kicker",
          "default": "Single-Origin"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Essential Oils"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Fallback Caption",
          "default": "Steam-distilled aromatic botanicals"
        },
        {
          "type": "url",
          "id": "custom_url",
          "label": "Custom Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Grid",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "kicker": "Steam-Distilled",
            "title": "Essential Oils",
            "caption": "Undiluted therapeutic botanical extracts"
          }
        },
        {
          "type": "category",
          "settings": {
            "kicker": "Cold-Pressed",
            "title": "Carrier Oils",
            "caption": "Unrefined nutrient-rich skin & scalp oils"
          }
        },
        {
          "type": "category",
          "settings": {
            "kicker": "Home Atmosphere",
            "title": "Diffusers",
            "caption": "Ultrasonic ceramic & waterless nebulizers"
          }
        },
        {
          "type": "category",
          "settings": {
            "kicker": "Targeted Care",
            "title": "Face & Scalp",
            "caption": "Botanical blends for daily rituals"
          }
        }
      ]
    }
  ]
}
{% endschema %}
