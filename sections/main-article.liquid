{%- style -%}
  #shopify-section-{{ section.id }} .main-article-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<article class="main-article-section" itemscope itemtype="https://schema.org/BlogPosting">
  <div class="botanical-page-hero">
    <div class="page-width article-detail-container">
      <div style="margin-bottom: 1.8rem;">
        <a href="{{ blog.url }}" class="botanical-page-eyebrow" style="display: inline-flex; align-items: center; gap: 0.6rem;">
          {{ 'blogs.article.back_to_blog' | t: title: blog.title }}
        </a>
      </div>
      <h1 itemprop="headline">{{ article.title | escape }}</h1>
      <div class="blog-article-meta" style="margin-top: 1.4rem;">
        {%- if section.settings.show_date -%}
          <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}" itemprop="datePublished">
            {{ article.published_at | date: '%B %d, %Y' }}
          </time>
        {%- endif -%}
        {%- if section.settings.show_author -%}
          <span itemprop="author" itemscope itemtype="https://schema.org/Person">
            &middot; <span itemprop="name">{{ 'blogs.article.by_author' | t: author: article.author }}</span>
          </span>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="page-width article-detail-container" style="padding-top: 4rem;">
    {%- if article.image != blank -%}
      <div style="margin-bottom: 3.6rem; border-radius: var(--card-radius); overflow: hidden; border: 1px solid var(--color-border);">
        {{ article.image | image_url: width: 1400 | image_tag:
          widths: '700, 1000, 1400',
          alt: article.image.alt | default: article.title,
          loading: 'eager',
          itemprop: 'image'
        }}
      </div>
    {%- endif -%}

    <div class="article-detail-body rte" itemprop="articleBody">
      {{ article.content }}
    </div>

    {%- if article.tags.size > 0 -%}
      <div style="margin-top: 4rem; padding-top: 2.4rem; border-top: 1px solid var(--color-border); display: flex; flex-wrap: wrap; gap: 1rem; align-items: center;">
        <span style="font-size: 1.25rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-primary);">
          {{ 'blogs.article.tags' | t }}:
        </span>
        {%- for tag in article.tags -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="tab-trigger" style="padding: 0.5rem 1.4rem; font-size: 1.2rem;">
            {{ tag }}
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if blog.comments_enabled? -%}
      <div style="margin-top: 5.5rem; padding-top: 4rem; border-top: 1px solid var(--color-border);">
        <h2 class="h3">{{ 'blogs.article.comments_title' | t }} ({{ article.comments_count }})</h2>

        {%- paginate article.comments by 10 -%}
          {%- if article.comments_count > 0 -%}
            <div style="display: flex; flex-direction: column; gap: 1.8rem; margin-bottom: 4rem;">
              {%- for comment in article.comments -%}
                <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--card-radius); padding: 2rem;">
                  <div style="font-weight: 600; color: var(--color-primary); margin-bottom: 0.6rem;">
                    {{ comment.author | escape }} &middot;
                    <span style="font-weight: 400; font-size: 1.25rem; color: var(--color-text-muted);">
                      {{ comment.created_at | date: '%b %d, %Y' }}
                    </span>
                  </div>
                  <div style="font-size: 1.45rem; color: var(--color-text-muted);">{{ comment.content }}</div>
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endpaginate -%}

        <div class="contact-form-card">
          <h3 class="h4" style="margin-bottom: 1.8rem;">{{ 'blogs.article.comment_form_title' | t }}</h3>
          {%- form 'new_comment', article -%}
            {%- if form.posted_successfully? -%}
              <div class="form-status-banner is-success" role="status">
                {%- if blog.moderated? -%}
                  {{ 'blogs.article.comment_success_moderated' | t }}
                {%- else -%}
                  {{ 'blogs.article.comment_success' | t }}
                {%- endif -%}
              </div>
            {%- elsif form.errors -%}
              <div class="form-status-banner is-error" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            <div class="contact-field-grid">
              <div class="contact-field">
                <label for="CommentAuthor-{{ section.id }}">{{ 'blogs.article.comment_name' | t }}</label>
                <input
                  id="CommentAuthor-{{ section.id }}"
                  type="text"
                  name="comment[author]"
                  value="{{ form.author }}"
                  required
                  aria-required="true"
                />
              </div>
              <div class="contact-field">
                <label for="CommentEmail-{{ section.id }}">{{ 'blogs.article.comment_email' | t }}</label>
                <input
                  id="CommentEmail-{{ section.id }}"
                  type="email"
                  name="comment[email]"
                  value="{{ form.email }}"
                  required
                  aria-required="true"
                />
              </div>
            </div>

            <div class="contact-field" style="margin-top: 1.6rem;">
              <label for="CommentBody-{{ section.id }}">{{ 'blogs.article.comment_message' | t }}</label>
              <textarea
                id="CommentBody-{{ section.id }}"
                rows="4"
                name="comment[body]"
                required
                aria-required="true"
              >{{ form.body }}</textarea>
            </div>

            {%- if blog.moderated? -%}
              <p style="font-size: 1.25rem; color: var(--color-text-muted); margin-top: 1.2rem;">
                {{ 'blogs.article.comment_moderated' | t }}
              </p>
            {%- endif -%}

            <div style="margin-top: 2rem;">
              <button type="submit" class="btn btn-primary">
                {{ 'blogs.article.comment_post' | t }}
              </button>
            </div>
          {%- endform -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</article>

{% schema %}
{
  "name": "Blog Article Detail",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show Publish Date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show Author Name",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Blog Article Detail"
    }
  ]
}
{% endschema %}
