{%- style -%}
  #shopify-section-{{ section.id }} .newsletter-banner-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="newsletter-banner-section" aria-labelledby="NewsletterBannerHeading-{{ section.id }}">
  <div class="page-width">
    <div class="newsletter-banner-box">
      {%- if section.settings.eyebrow != blank -%}
        <p class="botanical-page-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 id="NewsletterBannerHeading-{{ section.id }}" style="color: #FAF9F5; margin-bottom: 1.2rem;">
        {{ section.settings.heading | default: 'sections.footer.newsletter_title' | t }}
      </h2>
      <p style="max-width: 56rem; margin-inline: auto; margin-bottom: 2.8rem; color: rgba(250, 249, 245, 0.85);">
        {{ section.settings.subtext | default: 'sections.footer.newsletter_subtext' | t }}
      </p>

      {%- form 'customer', id: 'NewsletterBannerForm', class: 'newsletter-banner-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,banner">
        {%- if form.posted_successfully? -%}
          <div class="form-status-banner is-success" role="status" style="width: 100%; margin-bottom: 0;">
            {{ 'sections.footer.newsletter_success' | t }}
          </div>
        {%- else -%}
          <label for="NewsletterBannerEmail-{{ section.id }}" class="visually-hidden">
            {{ 'sections.footer.email_placeholder' | t }}
          </label>
          <input
            id="NewsletterBannerEmail-{{ section.id }}"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            placeholder="{{ 'sections.footer.email_placeholder' | t }}"
            required
            aria-required="true"
            style="background: #FAF9F5; color: #0D2F32;"
          />
          <button type="submit" class="btn btn-accent" style="flex-shrink: 0;">
            {{ section.settings.button_label | default: 'sections.footer.subscribe' | t }}
          </button>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter Banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Ghosoun Inner Circle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Seasonal Botanical Notes & New Harvests"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Subscribe for single-origin harvest releases, aromatherapy dilution guides, and private seasonal previews."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Subscribe"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Newsletter Banner"
    }
  ]
}
{% endschema %}
