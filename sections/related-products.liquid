{%- style -%}
  #shopify-section-{{ section.id }} .related-products-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-top: 1px solid var(--color-border);
  }
{%- endstyle -%}

<section class="related-products-section" aria-labelledby="RelatedHeading-{{ section.id }}">
  <div class="page-width">
    <product-recommendations
      data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}"
    >
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        <div style="text-align: center; margin-bottom: 3.6rem;">
          <p class="botanical-page-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          <h2 id="RelatedHeading-{{ section.id }}">
            {{ section.settings.heading | default: 'products.product.related_heading' | t }}
          </h2>
        </div>

        <div class="botanical-grid-4">
          {%- for recommendation in recommendations.products -%}
            {%- render 'product-card',
              product: recommendation,
              card_ratio: section.settings.image_ratio
            -%}
          {%- endfor -%}
        </div>
      {%- elsif collections.all.products_count > 1 -%}
        <div style="text-align: center; margin-bottom: 3.6rem;">
          <p class="botanical-page-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          <h2 id="RelatedHeading-{{ section.id }}">
            {{ section.settings.heading | default: 'products.product.related_heading' | t }}
          </h2>
        </div>

        <div class="botanical-grid-4">
          {%- assign shown_count = 0 -%}
          {%- for candidate in collections.all.products -%}
            {%- if candidate.id != product.id and shown_count < section.settings.products_to_show -%}
              {%- render 'product-card',
                product: candidate,
                card_ratio: section.settings.image_ratio
              -%}
              {%- assign shown_count = shown_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </product-recommendations>
  </div>
</section>

{% schema %}
{
  "name": "Related Products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Botanical Pairings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pair With Complementary Botanicals"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 2,
      "label": "Products to Show",
      "default": 4
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Card Image Ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/5", "label": "Botanical Tall (4:5)" }
      ],
      "default": "4/5"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Related Products"
    }
  ]
}
{% endschema %}
