{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .product-main-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: start;
  }

  @media screen and (min-width: 990px) {
    .product-main-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 6rem;
    }
    .product-info-sticky {
      position: sticky;
      top: 10rem;
    }
  }

  .product-gallery-stage {
    position: relative;
    background-color: var(--color-card-bg, #FFFFFF);
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius, 6px);
    overflow: hidden;
    margin-bottom: 1.4rem;
  }

  .product-gallery-slide {
    display: none;
    position: relative;
    aspect-ratio: 1 / 1;
  }

  .product-gallery-slide.is-active {
    display: block;
  }

  .product-gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: zoom-in;
  }

  .product-zoom-btn {
    position: absolute;
    bottom: 1.6rem;
    inset-inline-end: 1.6rem;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.94);
    border: 1px solid var(--color-border);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .product-zoom-btn:hover {
    transform: scale(1.06);
    background-color: #FFFFFF;
  }

  .product-thumbs-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(74px, 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .product-thumb-btn {
    padding: 0;
    border: 2px solid transparent;
    border-radius: var(--image-radius, 6px);
    background: var(--color-card-bg, #FFFFFF);
    overflow: hidden;
    cursor: pointer;
    aspect-ratio: 1 / 1;
    opacity: 0.72;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }

  .product-thumb-btn.is-active,
  .product-thumb-btn:hover {
    opacity: 1;
    border-color: var(--color-primary);
  }

  .product-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-zoom-modal {
    position: fixed;
    inset: 0;
    background-color: rgba(13, 47, 50, 0.92);
    z-index: 2000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .product-zoom-modal.is-open {
    display: flex;
  }

  .product-zoom-modal-img {
    max-width: 92vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: var(--image-radius, 6px);
  }

  .product-zoom-close {
    position: absolute;
    top: 2.4rem;
    inset-inline-end: 2.4rem;
    width: 4.4rem;
    height: 4.4rem;
    border-radius: 50%;
    background: #FFFFFF;
    border: none;
    color: var(--color-primary);
    font-size: 2.4rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .botanical-specs-card {
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius, 6px);
    padding: 1.6rem 2rem;
    margin-bottom: 2.2rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.4rem;
  }

  .botanical-spec-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .botanical-spec-label {
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .botanical-spec-value {
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .botanical-spec-value.is-latin {
    font-style: italic;
  }

  .product-stock-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 0.8rem;
    color: var(--color-secondary);
  }

  .product-stock-pill[data-available="false"] {
    color: var(--color-sale-badge);
  }

  .variant-fieldset {
    border: none;
    padding: 0;
    margin: 0 0 2rem;
  }

  .variant-legend {
    font-size: 1.25rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
    color: var(--color-primary);
    display: block;
  }

  .variant-pills-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .variant-pill-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .variant-pill-label {
    padding: 1rem 2rem;
    border: var(--btn-border-width, 1px) solid var(--color-border);
    border-radius: var(--btn-radius, 4px);
    background-color: var(--color-card-bg, #FFFFFF);
    color: var(--color-text);
    font-size: 1.35rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    user-select: none;
  }

  .variant-pill-input:checked + .variant-pill-label {
    background-color: var(--color-primary);
    color: var(--color-btn-text, #FAF9F5);
    border-color: var(--color-primary);
  }

  .variant-pill-input:focus-visible + .variant-pill-label {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .quantity-selector-wrap {
    margin-bottom: 2rem;
  }

  .quantity-box {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--btn-radius, 4px);
    background-color: var(--color-card-bg, #FFFFFF);
    overflow: hidden;
  }

  .quantity-btn {
    width: 4.2rem;
    height: 4.2rem;
    background: transparent;
    border: none;
    font-size: 1.8rem;
    color: var(--color-primary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .quantity-btn:hover {
    background-color: var(--color-bg-secondary);
  }

  .quantity-input {
    width: 5.4rem;
    height: 4.2rem;
    border: none !important;
    text-align: center;
    font-size: 1.5rem;
    font-weight: 600;
    padding: 0 !important;
    -moz-appearance: textfield;
  }

  .quantity-input::-webkit-outer-spin-button,
  .quantity-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .product-buy-buttons {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    margin-bottom: 2.4rem;
  }

  .shopify-payment-button__button {
    border-radius: var(--btn-radius, 4px) !important;
    font-family: var(--font-button-family, var(--font-body-family)) !important;
    text-transform: var(--button-transform, uppercase) !important;
    letter-spacing: 0.1em !important;
    font-size: 1.35rem !important;
  }

  .product-trust-strip {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
    padding: 1.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius, 6px);
    background-color: var(--color-card-bg, #FFFFFF);
    margin-bottom: 2.4rem;
  }

  .product-trust-badge {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .product-trust-badge svg {
    width: 2rem;
    height: 2rem;
    color: var(--color-secondary, var(--color-accent));
    flex-shrink: 0;
  }

  .product-accordion {
    border-top: 1px solid var(--color-border);
  }

  .product-accordion-details {
    border-bottom: 1px solid var(--color-border);
  }

  .product-accordion-summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.6rem 0;
    cursor: pointer;
    font-size: 1.4rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
  }

  .product-accordion-summary::-webkit-details-marker {
    display: none;
  }

  .product-accordion-body {
    padding-bottom: 1.8rem;
    font-size: 1.45rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }
{%- endstyle -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}

<section class="main-product-section" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="product-main-grid">

      <!-- LEFT COLUMN: MEDIA GALLERY + THUMBNAILS + ZOOM MODAL -->
      <div class="product-media-column">
        <div class="product-gallery-stage" id="ProductGalleryStage-{{ section.id }}">
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              {%- assign is_active = false -%}
              {%- if current_variant.featured_media and current_variant.featured_media.id == media.id -%}
                {%- assign is_active = true -%}
              {%- elsif current_variant.featured_media == blank and forloop.first -%}
                {%- assign is_active = true -%}
              {%- endif -%}

              <div
                class="product-gallery-slide {% if is_active %}is-active{% endif %}"
                data-media-id="{{ media.id }}"
                data-zoom-src="{{ media | image_url: width: 2000 }}"
              >
                {{ media | image_url: width: 1200 | image_tag:
                  loading: 'eager',
                  widths: '375, 550, 750, 1100, 1500',
                  class: 'product-gallery-img',
                  alt: media.alt | default: product.title
                }}
              </div>
            {%- endfor -%}

            <button
              type="button"
              class="product-zoom-btn"
              aria-label="{{ 'general.accessibility.zoom_image' | t }}"
              data-zoom-trigger="{{ section.id }}"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
            </button>
          {%- else -%}
            <div class="product-gallery-slide is-active">
              {{ 'product-1' | placeholder_svg_tag: 'product-gallery-img' }}
            </div>
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <ul class="product-thumbs-list" role="list">
            {%- for media in product.media -%}
              {%- assign is_active = false -%}
              {%- if current_variant.featured_media and current_variant.featured_media.id == media.id -%}
                {%- assign is_active = true -%}
              {%- elsif current_variant.featured_media == blank and forloop.first -%}
                {%- assign is_active = true -%}
              {%- endif -%}
              <li>
                <button
                  type="button"
                  class="product-thumb-btn {% if is_active %}is-active{% endif %}"
                  data-thumb-media-id="{{ media.id }}"
                  aria-label="{{ product.title | escape }} {{ forloop.index }}"
                >
                  {{ media.preview_image | image_url: width: 240 | image_tag:
                    loading: 'lazy',
                    widths: '120, 240',
                    class: 'product-thumb-img',
                    alt: media.alt | default: product.title
                  }}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <!-- Fullscreen Image Zoom Modal -->
        <div class="product-zoom-modal" id="ProductZoomModal-{{ section.id }}" role="dialog" aria-modal="true" aria-label="{{ product.title | escape }}">
          <button type="button" class="product-zoom-close" data-zoom-close="{{ section.id }}" aria-label="{{ 'general.accessibility.close' | t }}">&times;</button>
          {%- if product.featured_media -%}
            {{ product.featured_media | image_url: width: 2000 | image_tag:
              loading: 'lazy',
              widths: '750, 1100, 1500, 2000',
              class: 'product-zoom-modal-img',
              id: 'ProductZoomImg-' | append: section.id,
              alt: product.title
            }}
          {%- endif -%}
        </div>
      </div>

      <!-- RIGHT COLUMN: STICKY PRODUCT DETAILS & BLOCKS -->
      <div class="product-info-column product-info-sticky">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when '@app' -%}
              <div {{ block.shopify_attributes }}>
                {% render block %}
              </div>

            {%- when 'title' -%}
              <div style="margin-bottom: 1.4rem;" {{ block.shopify_attributes }}>
                {%- if block.settings.show_pure_badge -%}
                  <span class="badge badge-botanical" style="margin-bottom: 1rem;">
                    {{ 'products.product.pure_guarantee' | t }}
                  </span>
                {%- endif -%}
                <h1 class="h2" style="margin-bottom: 0.4rem;">{{ product.title | escape }}</h1>
                {%- if current_variant.sku != blank -%}
                  <div style="font-size: 1.2rem; color: var(--color-text-muted);" id="ProductSku-{{ section.id }}">
                    {{ 'products.product.sku' | t }}: {{ current_variant.sku }}
                  </div>
                {%- endif -%}
              </div>

            {%- when 'botanical_specs' -%}
              {%- assign latin_name = product.metafields.custom.botanical_name | default: block.settings.fallback_latin_name -%}
              {%- assign plant_part = product.metafields.custom.plant_part | default: block.settings.fallback_plant_part -%}
              {%- assign extraction = product.metafields.custom.extraction_method | default: block.settings.fallback_extraction -%}
              {%- assign origin = product.metafields.custom.country_of_origin | default: block.settings.fallback_origin -%}
              <div class="botanical-specs-card" {{ block.shopify_attributes }}>
                <div class="botanical-spec-item">
                  <span class="botanical-spec-label">{{ 'products.product.botanical_name_label' | t }}</span>
                  <span class="botanical-spec-value is-latin">{{ latin_name | escape }}</span>
                </div>
                <div class="botanical-spec-item">
                  <span class="botanical-spec-label">{{ 'products.product.plant_part_label' | t }}</span>
                  <span class="botanical-spec-value">{{ plant_part | escape }}</span>
                </div>
                <div class="botanical-spec-item">
                  <span class="botanical-spec-label">{{ 'products.product.extraction_label' | t }}</span>
                  <span class="botanical-spec-value">{{ extraction | escape }}</span>
                </div>
                <div class="botanical-spec-item">
                  <span class="botanical-spec-label">{{ 'products.product.origin_label' | t }}</span>
                  <span class="botanical-spec-value">{{ origin | escape }}</span>
                </div>
              </div>

            {%- when 'price' -%}
              <div id="ProductPrice-{{ section.id }}" style="margin-bottom: 2rem;" {{ block.shopify_attributes }}>
                <div style="display: flex; align-items: baseline; flex-wrap: wrap; gap: 1.2rem;">
                  <span style="font-size: 2.6rem; font-weight: 700; color: var(--color-primary);" data-product-price>
                    {{ current_variant.price | money }}
                  </span>
                  {%- if current_variant.compare_at_price > current_variant.price -%}
                    {%- assign saved_amount = current_variant.compare_at_price | minus: current_variant.price | money_without_trailing_zeros -%}
                    <span class="card-price-compare" style="font-size: 1.8rem;" data-product-compare-price>
                      {{ current_variant.compare_at_price | money }}
                    </span>
                    <span class="badge badge-sale" data-product-save-badge>
                      {{ 'products.product.save' | t: amount: saved_amount }}
                    </span>
                  {%- endif -%}
                </div>
                <div
                  id="ProductStockStatus-{{ section.id }}"
                  class="product-stock-pill"
                  data-available="{{ current_variant.available }}"
                >
                  {%- if current_variant.available -%}
                    {%- if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 5 -%}
                      {{ 'products.product.quantity_low' | t }}
                    {%- else -%}
                      {{ 'products.product.in_stock' | t }}
                    {%- endif -%}
                  {%- else -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- endif -%}
                </div>
                {%- if block.settings.tax_notice != blank -%}
                  <p style="font-size: 1.25rem; color: var(--color-text-muted); margin-top: 0.4rem; margin-bottom: 0;">
                    {{ block.settings.tax_notice | escape }}
                  </p>
                {%- endif -%}
              </div>

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <variant-radios
                  data-section="{{ section.id }}"
                  data-url="{{ product.url }}"
                  {{ block.shopify_attributes }}
                >
                  {%- for option in product.options_with_values -%}
                    <fieldset class="variant-fieldset">
                      <legend class="variant-legend">
                        {{ option.name }}: <span data-selected-option-value>{{ option.selected_value }}</span>
                      </legend>
                      <div class="variant-pills-wrap">
                        {%- for value in option.values -%}
                          <input
                            type="radio"
                            class="variant-pill-input"
                            id="Option-{{ section.id }}-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}"
                            name="{{ option.name }}"
                            value="{{ value | escape }}"
                            form="ProductForm-{{ section.id }}"
                            {% if option.selected_value == value %}checked{% endif %}
                          >
                          <label
                            class="variant-pill-label"
                            for="Option-{{ section.id }}-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}"
                          >
                            {{ value }}
                          </label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                  <script type="application/json">
                    {{ product.variants | json }}
                  </script>
                </variant-radios>
              {%- endunless -%}

            {%- when 'quantity_selector' -%}
              <div class="quantity-selector-wrap" {{ block.shopify_attributes }}>
                <label class="variant-legend" for="Quantity-{{ section.id }}">
                  {{ 'general.cart.quantity' | t }}
                </label>
                <div class="quantity-box">
                  <button type="button" class="quantity-btn" data-qty-change="-1" aria-label="{{ 'general.cart.decrease_quantity' | t }}">&minus;</button>
                  <input
                    type="number"
                    id="Quantity-{{ section.id }}"
                    class="quantity-input"
                    name="quantity"
                    value="1"
                    min="1"
                    form="ProductForm-{{ section.id }}"
                  >
                  <button type="button" class="quantity-btn" data-qty-change="1" aria-label="{{ 'general.cart.increase_quantity' | t }}">&#43;</button>
                </div>
              </div>

            {%- when 'buy_buttons' -%}
              <product-form {{ block.shopify_attributes }}>
                {%- form 'product', product, id: 'ProductForm-' | append: section.id, class: 'product-buy-buttons', data-product-form: '' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}">
                  <button
                    type="submit"
                    name="add"
                    class="btn btn-primary"
                    style="width: 100%; padding: 1.6rem;"
                    data-action="quick-add"
                    {% unless current_variant.available %}disabled{% endunless %}
                  >
                    <span data-add-to-cart-text>
                      {%- if current_variant.available -%}
                        {{ 'products.product.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </span>
                  </button>

                  {%- if block.settings.show_dynamic_checkout -%}
                    {{ form | payment_button }}
                  {%- endif -%}

                  <div class="product-form-error" role="alert" data-product-form-error hidden></div>
                {%- endform -%}
              </product-form>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div style="font-size: 1.45rem; line-height: 1.75; color: var(--color-text); margin-bottom: 2.4rem;" {{ block.shopify_attributes }}>
                  {{ product.description }}
                </div>
              {%- endif -%}

            {%- when 'trust_badges' -%}
              <div class="product-trust-strip" {{ block.shopify_attributes }}>
                <div class="product-trust-badge">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
                  <span>{{ block.settings.badge_1 | escape }}</span>
                </div>
                <div class="product-trust-badge">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  <span>{{ block.settings.badge_2 | escape }}</span>
                </div>
                <div class="product-trust-badge">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><rect x="6" y="2" width="12" height="20" rx="3"/><line x1="6" y1="10" x2="18" y2="10"/></svg>
                  <span>{{ block.settings.badge_3 | escape }}</span>
                </div>
                <div class="product-trust-badge">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><path d="M9 12l2 2 4-4"/></svg>
                  <span>{{ block.settings.badge_4 | escape }}</span>
                </div>
              </div>

            {%- when 'collapsible_tab' -%}
              <div class="product-accordion" {{ block.shopify_attributes }}>
                <details class="product-accordion-details" {% if block.settings.open_by_default %}open{% endif %}>
                  <summary class="product-accordion-summary">
                    <span>{{ block.settings.heading | escape }}</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><polyline points="6 9 12 15 18 9"/></svg>
                  </summary>
                  <div class="product-accordion-body">
                    {{ block.settings.content }}
                  </div>
                </details>
              </div>

          {%- endcase -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main Product",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "title",
      "name": "Product Title",
      "limit": 1,
      "settings": [
        {
