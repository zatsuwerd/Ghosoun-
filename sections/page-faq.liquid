{%- style -%}
  #shopify-section-{{ section.id }} .faq-page-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="faq-page-section">
  <div class="botanical-page-hero">
    <div class="page-width">
      <p class="botanical-page-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1>{{ section.settings.heading | default: page.title | escape }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="botanical-page-subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="page-width" style="padding-top: 4.5rem; max-width: 92rem;">
    <faq-accordion>
      <div class="faq-controls">
        {%- if section.settings.show_search -%}
          <div>
            <label for="FaqSearch-{{ section.id }}" class="visually-hidden">
              {{ 'sections.faq.search_placeholder' | t }}
            </label>
            <input
              id="FaqSearch-{{ section.id }}"
              type="search"
              data-faq-search
              placeholder="{{ 'sections.faq.search_placeholder' | t }}"
              autocomplete="off"
            />
          </div>
        {%- endif -%}

        <div class="faq-category-tabs" role="group" aria-label="FAQ Categories">
          <button
            type="button"
            class="tab-trigger is-active"
            data-faq-category-btn="all"
          >
            {{ 'sections.faq.all_categories' | t }}
          </button>
          <button type="button" class="tab-trigger" data-faq-category-btn="Purity & Sourcing">
            Purity &amp; Sourcing
          </button>
          <button type="button" class="tab-trigger" data-faq-category-btn="Usage & Safety">
            Usage &amp; Safety
          </button>
          <button type="button" class="tab-trigger" data-faq-category-btn="Orders & Shipping">
            Orders &amp; Shipping
          </button>
        </div>
      </div>

      <div class="faq-accordion-list">
        {%- for block in section.blocks -%}
          <div
            class="faq-item"
            data-faq-item
            data-faq-category="{{ block.settings.category | escape }}"
            {{ block.shopify_attributes }}
          >
            <button
              type="button"
              class="faq-question-btn"
              data-faq-trigger
              aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="FaqAnswer-{{ section.id }}-{{ forloop.index }}"
            >
              <span>{{ block.settings.question | escape }}</span>
              <span aria-hidden="true" style="font-size: 1.8rem; color: var(--color-accent);">+</span>
            </button>
            <div
              id="FaqAnswer-{{ section.id }}-{{ forloop.index }}"
              class="faq-answer-panel"
              {% unless forloop.first %}hidden{% endunless %}
            >
              {{ block.settings.answer }}
            </div>
          </div>
        {%- endfor -%}
      </div>

      <p data-faq-empty hidden style="text-align: center; padding: 3.5rem 0; color: var(--color-text-muted);">
        {{ 'sections.faq.no_matches' | t }}
      </p>
    </faq-accordion>
  </div>
</section>

{% schema %}
{
  "name": "FAQ Accordion Page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Ghosoun Help Center"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Guidance on single-origin botanical sourcing, safe topical dilution, diffuser care, and order delivery."
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Enable FAQ Keyword Filter",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Question",
      "settings": [
        {
          "type": "select",
          "id": "category",
          "label": "Category",
          "options": [
            { "value": "Purity & Sourcing", "label": "Purity & Sourcing" },
            { "value": "Usage & Safety", "label": "Usage & Safety" },
            { "value": "Orders & Shipping", "label": "Orders & Shipping" }
          ],
          "default": "Purity & Sourcing"
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Are Ghosoun essential oils 100% pure and undiluted?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes. Every Ghosoun essential oil is bottled neat without synthetic fragrances, carrier fillers, or artificial solvents.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion Page",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "category": "Purity & Sourcing",
            "question": "Are Ghosoun essential oils 100% pure and undiluted?",
            "answer": "<p>Yes. Every Ghosoun essential oil is 100% pure and bottled without synthetic fragrances, carrier oil diluents, or artificial colorants.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "category": "Purity & Sourcing",
            "question": "Why does Ghosoun package oils in dark UV-protective glass?",
            "answer": "<p>UV-filtering dark glass shields delicate aromatic terpenes and cold-pressed fatty acids from light-induced oxidation, helping preserve freshness naturally.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "category": "Usage & Safety",
            "question": "How should I dilute essential oils with carrier oils for skin or scalp?",
            "answer": "<p>For facial blends, add 1 drop of essential oil per 10ml of cold-pressed carrier oil (around 0.5% dilution). For scalp or body massage, blend 3 to 5 drops per tablespoon of Jojoba or Argan oil (1.5% to 2.5%).</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "category": "Orders & Shipping",
            "question": "How is complimentary shipping calculated at checkout?",
            "answer": "<p>Complimentary shipping thresholds and express courier rates configured in your Shopify store settings calculate automatically at checkout based on your delivery region.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
