{%- style -%}
  #shopify-section-{{ section.id }} .list-collections-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="list-collections-section">
  <div class="botanical-page-hero">
    <div class="page-width">
      <p class="botanical-page-eyebrow">Ghosoun</p>
      <h1>{{ section.settings.heading | default: 'collections.general.catalog_title' | t }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="botanical-page-subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="page-width" style="padding-top: 5rem;">
    {%- paginate collections by section.settings.collections_per_page -%}
      <div class="botanical-grid-3">
        {%- for collection in collections -%}
          <article class="category-card">
            <a href="{{ collection.url }}" class="category-card-media">
              {%- if collection.featured_image != blank -%}
                {{ collection.featured_image | image_url: width: 900 | image_tag:
                  widths: '400, 700, 900',
                  sizes: '(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw',
                  alt: collection.featured_image.alt | default: collection.title,
                  loading: 'lazy'
                }}
              {%- else -%}
                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, var(--color-primary), #174B4E); color: #FAF9F5; padding: 2.4rem; text-align: center;">
                  <span style="font-family: var(--font-heading-family); font-size: 2.4rem;">{{ collection.title | escape }}</span>
                </div>
              {%- endif -%}
            </a>
            <div class="category-card-body">
              <h2 class="h3" style="margin-bottom: 0.6rem;">
                <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
              </h2>
              <p style="font-size: 1.35rem; color: var(--color-text-muted); margin-bottom: 1.8rem;">
                {{ 'collections.general.products_count' | t: count: collection.all_products_count }}
              </p>
              <a href="{{ collection.url }}" class="btn btn-secondary btn-sm" style="align-self: flex-start; margin-top: auto;">
                {{ 'collections.general.view_collection' | t }}
              </a>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav aria-label="{{ 'general.pagination.label' | t }}" style="display: flex; justify-content: center; gap: 1.2rem; margin-top: 4.5rem;">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="btn btn-secondary btn-sm">{{ 'general.pagination.previous' | t }}</a>
          {%- endif -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="btn btn-secondary btn-sm">{{ 'general.pagination.next' | t }}</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections Directory",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Botanical Collections"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Explore pure single-origin essential oils, cold-pressed carrier elixirs, diffusers, and daily rituals."
    },
    {
      "type": "range",
      "id": "collections_per_page",
      "min": 6,
      "max": 24,
      "step": 3,
      "label": "Collections Per Page",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 72
    }
  ]
}
{% endschema %}
