          assign d_price = 'AED 145.00'
          assign d_compare = ''
          assign d_badge = ''
      endcase
  endcase
-%}

<article class="product-card" data-demo-product="{{ d_title | handle }}">
  <div class="card-media-wrapper" data-ratio="{{ aspect_ratio }}">
    <div class="card-badges">
      {%- if d_badge != blank -%}
        <span class="badge badge-sale">{{ d_badge }}</span>
      {%- endif -%}
      {%- if settings.show_purity_badge -%}
        <span class="badge badge-botanical">{{ 'products.product.pure_guarantee' | t }}</span>
      {%- endif -%}
    </div>

    <a href="{{ routes.all_products_collection_url }}" class="card-media-link" aria-label="{{ d_title | escape }}">
      <div style="width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; background: linear-gradient(155deg, var(--color-bg-secondary) 0%, var(--color-bg) 100%); padding: 2rem;">
        <svg width="74" height="110" viewBox="0 0 74 110" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
          <rect x="28" y="6" width="18" height="14" rx="2" fill="#0D2F32"/>
          <rect x="25" y="20" width="24" height="6" rx="1.5" fill="#C59B43"/>
          <path d="M27 26H47L53 36V96C53 99.3137 50.3137 102 47 102H27C23.6863 102 21 99.3137 21 96V36L27 26Z" fill="#0D2F32" stroke="#217C42" stroke-width="1.5"/>
          <rect x="25" y="48" width="24" height="36" rx="2" fill="#FAF9F5" fill-opacity="0.96"/>
          <line x1="29" y1="58" x2="45" y2="58" stroke="#0D2F32" stroke-width="1.5"/>
          <line x1="29" y1="64" x2="45" y2="64" stroke="#217C42" stroke-width="1.2"/>
          <line x1="31" y1="74" x2="43" y2="74" stroke="#C59B43" stroke-width="1.2"/>
        </svg>
      </div>
    </a>
  </div>

  <div class="card-content" data-align="{{ card_align }}">
    {%- if settings.show_vendor -%}
      <div class="card-vendor">{{ shop.name }}</div>
    {%- endif -%}

    {%- if settings.show_botanical_name -%}
      <div class="card-botanical-name">{{ d_latin }}</div>
    {%- endif -%}

    <h3 class="card-title">
      <a href="{{ routes.all_products_collection_url }}">{{ d_title }}</a>
    </h3>

    <div class="card-price-row">
      <span>{{ d_price }}</span>
      {%- if d_compare != blank -%}
        <span class="card-price-compare">{{ d_compare }}</span>
      {%- endif -%}
    </div>

    {%- if settings.show_quick_add -%}
      <a href="{{ routes.all_products_collection_url }}" class="btn btn-secondary card-quick-add-btn">
        {{ 'products.product.choose_options' | t }}
      </a>
    {%- endif -%}
  </div>
</article>
