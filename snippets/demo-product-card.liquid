{%- comment -%}
  Renders fallback showcase product cards for Ghosoun (غصون) when a collection
  has not yet been populated or assigned in the Theme Editor.
  Accepts:
  - demo_index: Integer 1..8
  - demo_tab: Optional tab label ('Bestsellers', 'Essential Oils', 'Carrier Oils', 'Diffusers')
  - ratio: Aspect ratio string '1/1', '3/4', or '4/5'
{%- endcomment -%}

{%- liquid
  assign idx = demo_index | default: 1
  assign tab_name = demo_tab | default: 'Bestsellers'
  assign aspect_ratio = ratio | default: settings.card_image_ratio | default: '4/5'
  assign card_align = settings.card_text_align | default: 'start'

  case tab_name
    when 'Essential Oils'
      case idx
        when 1
          assign d_title = 'Rosemary Essential Oil'
          assign d_latin = 'Rosmarinus officinalis · Mediterranean'
          assign d_price = 'From AED 69.00'
          assign d_compare = 'AED 85.00'
          assign d_badge = 'Save AED 16'
        when 2
          assign d_title = 'High-Altitude Lavender Oil'
          assign d_latin = 'Lavandula angustifolia · Provence'
          assign d_price = 'From AED 79.00'
          assign d_compare = ''
          assign d_badge = ''
        when 3
          assign d_title = 'Dhofar Frankincense Sacra Oil'
          assign d_latin = 'Boswellia sacra · Oman'
          assign d_price = 'AED 165.00'
          assign d_compare = 'AED 195.00'
          assign d_badge = 'Save AED 30'
        when 4
          assign d_title = 'Peppermint Botanical Oil'
          assign d_latin = 'Mentha piperita · Leaves'
          assign d_price = 'AED 55.00'
          assign d_compare = ''
          assign d_badge = ''
        when 5
          assign d_title = 'Calabrian Bergamot Peel Oil'
          assign d_latin = 'Citrus bergamia · Cold Expressed'
          assign d_price = 'AED 89.00'
          assign d_compare = ''
          assign d_badge = ''
        when 6
          assign d_title = 'Tea Tree Steam-Distilled Oil'
          assign d_latin = 'Melaleuca alternifolia · Leaves'
          assign d_price = 'AED 65.00'
          assign d_compare = ''
          assign d_badge = ''
        when 7
