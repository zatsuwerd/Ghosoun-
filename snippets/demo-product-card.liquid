          assign d_latin = 'Simmondsia chinensis · First Press'
          assign d_price = 'AED 145.00'
          assign d_compare = ''
          assign d_badge = ''
        when 4
          assign d_title = 'Black Seed Botanical Oil'
          assign d_latin = 'Nigella sativa · Cold-Pressed'
          assign d_price = 'AED 135.00'
          assign d_compare = ''
          assign d_badge = ''
        when 5
