          assign d_price = 'AED 75.00'
          assign d_compare = ''
          assign d_badge = ''
      endcase
    when 'Diffusers'
      case idx
        when 1
          assign d_title = 'Alabaster Ceramic Ultrasonic Diffuser'
          assign d_latin = 'Stoneware Ceramic · Soft Mist'
          assign d_price = 'AED 295.00'
          assign d_compare = 'AED 340.00'
