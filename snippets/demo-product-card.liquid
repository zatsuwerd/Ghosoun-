          assign d_badge = 'Save AED 20'
        when 4
          assign d_title = 'High-Altitude Lavender Oil'
          assign d_latin = 'Lavandula angustifolia · Provence'
          assign d_price = 'From AED 79.00'
          assign d_compare = ''
          assign d_badge = ''
        when 5
          assign d_title = 'Dhofar Frankincense Sacra Oil'
          assign d_latin = 'Boswellia sacra · Oman'
          assign d_price = 'AED 165.00'
          assign d_compare = 'AED 195.00'
          assign d_badge = 'Save AED 30'
        when 6
          assign d_title = 'Wild Rosehip Seed Facial Oil'
          assign d_latin = 'Rosa rubiginosa · Unrefined'
          assign d_price = 'AED 115.00'
          assign d_compare = ''
          assign d_badge = ''
        when 7
          assign d_title = 'Alabaster Ceramic Ultrasonic Diffuser'
          assign d_latin = 'Stoneware Ceramic · Soft Mist'
